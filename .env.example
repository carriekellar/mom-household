OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# Exact public HTTPS URL configured as the Twilio number incoming-message webhook (POST).
TWILIO_WEBHOOK_URL=https://your-host.example/sms
HOUSEHOLD_TIMEZONE=America/New_York
DATABASE_PATH=household.sqlite3
PORT=8000
# Vercel + Supabase only: direct or SESSION pooler URL, with sslmode=require.
DATABASE_URL=
# Random secret shared only with Supabase Vault; protects /api/process.
CRON_SECRET=

# Lifetime outbound API attempt cap per database; not a billed-segment counter.
SMS_SEND_LIMIT=100

# Optional Sendblue provider; leave SMS_PROVIDER=twilio until cutover is complete.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_PHONE_NUMBER=
# Configure this same secret on BOTH receive and outbound Sendblue webhooks.
SENDBLUE_WEBHOOK_SECRET=
