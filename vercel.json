{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/sms",
      "destination": "/api/sms"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/opt-in",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "outputDirectory": "public"
}
